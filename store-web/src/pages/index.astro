---
import Store from '../layouts/Store.astro';
import Link from "@components/Link.astro";


let number = Math.floor(Math.random() * 15) + 1;

let image = "image" + number + ".jpg"

---

<Store>
  <div class="px-4 sm:px-10 py-6">
        <div class="max-w-screen-xl max-lg:max-w-3xl mx-auto">
          <div class="grid lg:grid-cols-2 items-center gap-x-12 gap-y-16">
            <div class="max-lg:text-center">
              <h1 class="lg:text-5xl text-4xl !leading-tight font-bold text-slate-900 mb-6">
                Conheça o Futuro da Produção Musical</h1>
              <p class="text-base text-slate-600 leading-relaxed">Descubra a melhor forma de contratar serviços para músicos de músicos adventistas. Confira nosso catálogo de serviços e inicie seu projeto musical com os melhores consultores do mercado.</p>

              <div class="mt-12 flex flex-wrap max-lg:justify-center gap-4">
                <Link cl="btn-secondary" url="/categories">Categorias</Link>
                <Link cl="btn-ghost" url="/professionals">Profissionais</Link>
              </div>
            </div>
            <div class="lg:lgw-full lg:aspect-[12/9]">
              <img src={image} class="md:w-full lg:h-full w-sm h-sm ml-auto mr-auto object-cover rounded-lg shadow-xl" alt="hero-img" />
            </div>
          </div>
        </div>
      </div>

      <div class="md:p-8 p-4" id="pr-wrapper" hx-get="/partials/public/products?limit=8" hx-trigger="load" hx-swap="innerHTML" ></div>

      <div class="md:p-8 p-4" id="pr-wrapper" hx-get="/partials/public/categories?limit=8" hx-trigger="load" hx-swap="innerHTML" ></div>


</Store>
