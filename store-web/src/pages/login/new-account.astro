---
import Layout from '../../layouts/Layout.astro';
import toaster from '@utils/toaster';

let data = null;

if (Astro.request.method === "POST") {

    const form = await Astro.request.formData();
    const name = form.get("name") as string;
    const email = form.get("email") as string;
    const password = form.get("password") as string;
    const password2 = form.get("password2") as string;

    if (!name || name.length < 4) {
        let r = `
      <input id="name" hx-swap-oob="true" name="name" type="text" required class="input input-error w-full text-slate-900 text-sm border border-slate-300 px-4 py-3 pr-8 rounded-md" placeholder="Nome completo" value='${name}' />
                 `;

        return new Response(r, {
            status: 200,
            headers: {"Content-Type": "text/html"}
        });
    }

    if (password.length < 6) {
        let r = `
      <input id="password" hx-swap-oob="true" name="password" type="password" required class="input input-error w-full text-slate-900 text-sm border border-slate-300 px-4 py-3 pr-8 rounded-md" placeholder="A senha deve conter 6 ou mais caracteres" />
    `
        return new Response(r, {
            status: 200,
            headers: {"Content-Type": "text/html"}
        });

    }

    if (password != password2) {
        let r = `
      <input id="password2" hx-swap-oob="true" name="password2" type="password" required class="input input-error w-full text-slate-900 text-sm border border-slate-300 px-4 py-3 pr-8 rounded-md" placeholder="A confirmação de senha deve ser igual" />
    `
        return new Response(r, {
            status: 200,
            headers: {"Content-Type": "text/html"}
        });

    }

    if (!email || email.length < 3 || email.indexOf('@') == -1) {
        let r = ` <input id="email" hx-swap-oob="true" name="email" type="text" required class="input input-error w-full text-slate-900 text-sm border border-slate-300 px-4 py-3 pr-8 rounded-md" placeholder="Insira um email válido" /> `
        return new Response(r, {
            status: 200,
            headers: {"Content-Type": "text/html"}
        });

    }

    try {
        // Validação básica
        if (!name || !email || !password) {
            return new Response(toaster.error("Nome e email são obrigatórios"), {
                status: 203,
                headers: {"Content-Type": "text/html"}
            });
        }

        let body = {name: name, email: email, password}

        const response = await Astro.locals.fetchWithAuth("users", {
            method: 'POST',
            body: JSON.stringify(body)
        });
        if (response.ok) {
            data = await response.json();
            // console.log(data)
        } else {
            let msg = await response.text()
            return new Response(toaster.alert("Erro ao salvar - " + msg), {
                status: 203,
                headers: {"Content-Type": "text/html"}
            });
        }

        return new Response(toaster.success("/login", "body"), {
            status: 200,
            headers: {"Content-Type": "text/html"}
        });

    } catch (error) {
        console.error("Erro ao processar formulário:", error);
        return new Response(toaster.alert("Erro interno"), {
            status: 203,
            headers: {"Content-Type": "text/html"}
        });
    }
}
---

<script is:inline>
    function test() {
        console.log('testing')
    }
</script>

<Layout>

