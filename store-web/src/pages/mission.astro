---
import Store from '../layouts/Store.astro';
---

<Store>
  <div class="px-4 py-8">
        <div class="grid lg:grid-cols-2 gap-12 lg:max-w-6xl max-w-2xl mx-auto">
          <div class="text-left">
            <h2 class="text-slate-900 text-3xl font-bold mb-6">Discover the Future of Innovation</h2>
            <p class="mb-4 text-[15px] text-slate-600 leading-relaxed">Unlock the power of data-driven decision making with our intelligent dashboard tools. Track performance metrics, visualize trends, and gain meaningful insights—all in one place. Whether you're managing a team, launching a new product, or optimizing business operations, our platform keeps you informed and ahead of the curve.</p>
            <p class="mb-4 text-[15px] text-slate-600 leading-relaxed">Seamlessly analyze key performance indicators across different departments. From revenue growth to engagement stats, customize the view to focus on what matters most to your goals.</p>
            <p class="text-[15px] text-slate-600 leading-relaxed">Our intuitive interface is designed for speed and clarity. No steep learning curves, no clutter—just powerful tools that let you turn data into action. Make informed choices with real-time updates and predictive analytics, helping you stay responsive and agile in today’s fast-moving digital world.</p>
          </div>
          <div>
            <img src="https://readymadeui.com/images/kpis-dashboard-img.webp" alt="hero Image" class="rounded-lg object-contain w-full h-full" />
          </div>
        </div>
      </div>

</Store>
