---
import Store from "@layouts/Store.astro";
import CheckoutBasket from "@components/CheckoutBasket.svelte";
import toaster from '@utils/toaster'

let data = null;

let c = Astro.cookies.get('auth_token');
if(!c){
  return Astro.redirect("/login");
}

if (Astro.request.method === "GET") {


  const result = await Astro.locals.fetchWithResult("my-basket");
  if(result.success){
    data = result.data;
  }
  else {
    console.log(result);
    data = null;
    // return new Response("/app", {
    //   status: 307,
    //   headers: { "Content-Type": "text/html", "Location": "/app" }
    // });
  }
}

if (Astro.request.method === "POST") {
  const form = await Astro.request.formData();

  const paymentMethod = form.get("paymentMethod");
  const message = form.get("message");

  if (!paymentMethod) {
    return new Response(toaster.alert("Forma de Pagamento Inválida"), {
      status: 203,
      headers: {"Content-Type": "text/html"}
    })
  }

  const body = {
   message,
   paymentMethod
  };

  try {
    const response = await Astro.locals.fetchWithResult("orders", {
      method: 'POST',
      body: JSON.stringify(body)
    })

    if (!response.success) {
      return new Response(toaster.error("Erro:" + response.message), {
        status: 203,
        headers: { "Content-Type": "text/html" }
      })
    }
  }
  catch(err){
    return new Response(toaster.error("Erro:" + err), {
      status: 203,
      headers: { "Content-Type": "text/html" }
    })
  }

  return new Response(toaster.successMessage("Pedido Criado", "/orders"), {
      status: 200,
      headers: { "Content-Type": "text/html" }
    });

  }

---

<Store >

  <div id="wrapper" class="max-w-6xl max-lg:max-w-2xl mx-auto bg-white p-4 md:p-8 mt-4">
  <CheckoutBasket data={data}></CheckoutBasket>

  <div hx-get="/partials/customer-info" hx-trigger="load">

  </div>

  <div class="bg-gray-">
    <h3 class="text-xl font-semibold text-slate-900 mt-8 mb-2">
      Informações de Pagamento
    </h3>

    <form hx-post="/basket/checkout" hx-target="#message" >
      <fieldset class="fieldset">
        <legend class="fieldset-legend">Forma de Pagamento</legend>
      <select id="select "
      name="paymentMethod"
      class="appearance-none cursor-pointer text-sm text-slate-900 bg-gray-100 border border-gray-300 outline-0 px-4 py-2 rounded-md">
        <option value="" disabled selected>Selecione</option>
                    <option value="Pix">PIX</option>
                    <option value="Direct">A Combinar</option>
                  </select>
      </fieldset>


      <fieldset class="fieldset">
        <legend class="fieldset-legend">Mensagem (opcional)</legend>
        <textarea
          name="message"
          rows="2"
          class="input resize-vertical"
          placeholder=""></textarea>
      </fieldset>

      <button class="btn-primary w-full mt-4">Confirmar Compra</button>

    </form>

  </div>

  </div>

  <div id="message"></div>

</Store>
