---
export const prerender = false;
import Management from '@layouts/Management.astro';
import Link from '@components/Link.astro';
import toaster from '@utils/toaster'
import BreadCrumbs from "@components/BreadCrumbs.svelte";

let data = null;
let isAdmin = false;

if (Astro.request.method === "GET") {

  const { slug } = Astro.params;
  if(slug){
    const result = await Astro.locals.fetchWithResult("product-types/" + slug);
    console.log(result);
    if(result.success){
      data = result.data;
      isAdmin = result.isAdmin;
    }
    else{
      return new Response("/management/product-types", {
        status: 307,
        headers: { "Content-Type": "text/html", "Location": "/management" }
      });

    }


  }
}

// Handler do POST no topo do arquivo .astro
if (Astro.request.method === "PUT") {
  try {
    const form = await Astro.request.formData();
    const id = form.get("id") as string;
    const name = form.get("name") as string;
    const pictureUrl = form.get("pictureUrl") as string;
    const isActive = form.get("isActive") as string;

    // Validação básica
    if (!name) {
      return new Response(toaster.error("Nome e email são obrigatórios"), {
        status: 203,
        headers: { "Content-Type": "text/html" }
      });
    }

    let body = {id, name, isActive: isActive == "on", pictureUrl}

    const response = await Astro.locals.fetchWithAuth("product-types/" + id, {method:'PUT', body:JSON.stringify(body)});
    if(response.ok){
      data = await response.json();
      // console.log(data)
    }
    else{
      let msg = await response.text()
      return new Response(toaster.error("Erro ao salvar - " + msg), {
        status: 203,
        headers: { "Content-Type": "text/html" }
      });
    }

    return new Response(toaster.success( "/management/product-types"), {
      status: 200,
      headers: { "Content-Type": "text/html" }
    });

  } catch (error) {
    console.error("Erro ao processar formulário:", error);
    return new Response("Erro interno do servidor", { status: 500 });
  }
}

---

<Management>

  <div class="page">
    <BreadCrumbs path=`management,management/product-types/,management/product-types/${data.id}` name="Gerenciamento, Usuários, Editar" />

    <h1 class="text-3xl font-semibold">Editar Categoria</h1>

    <Link url="/management/product-types" cl="btn-neutral mt-8">Voltar</Link>
    <form class="mt-8" hx-put={"/management/product-types/" + data.id} hx-target="#message">

      { () => {if (data) return (

      <fieldset class="fieldset">
        <legend class="fieldset-legend">Nome</legend>
        <input value={data.name} type="text" class="input" name="name" placeholder="Insira o nome" />
      </fieldset>


      <fieldset class="fieldset">
        <legend class="fieldset-legend">Url Interna</legend>
        <input value={data.pictureUrl} type="text" class="input" name="pictureUrl" placeholder="/image1.jpg" />
      </fieldset>

      <input value={data.id} type="hidden" class="input" name="id" />

      <fieldset class="fieldset">
        <legend class="fieldset-legend">Ativo</legend>
        <input type="checkbox"  class="checkbox" checked={data.isActive} name="isActive" />
      </fieldset>

      )}

      }
      <button class=" btn btn-primary mt-0" type="submit" >Salvar</button>
    </form>

    <p id="message"></p>

  </div>

</Management>
