---
import Management from '@layouts/Management.astro';
import toaster from '@utils/toaster'
import Link from "@components/Link.astro";
import BreadCrumbs from "@components/BreadCrumbs.svelte";

let data = null;

// Handler do POST no topo do arquivo .astro
if (Astro.request.method === "POST") {
  try {
    const form = await Astro.request.formData();
    const id = form.get("id") as string;
    const name = form.get("name") as string;
    const pictureUrl = form.get("pictureUrl") as string;
    const isActive = form.get("isActive") as string;

    // Validação básica
    if (!name) {
      return toaster.inputValidation("name-message", "Nome Obrigatório")
    }

    if (!pictureUrl) {
      return toaster.inputValidation("pic-message", "Email Obrigatório")
    }

    let body = {id, name, isActive:true, pictureUrl}

    const response = await Astro.locals.fetchWithAuth("product-types", {method:'POST', body:JSON.stringify(body)});
    if(response.ok){
      data = await response.json();
      // console.log(data)
    }
    else{
      let msg = await response.text()
      return new Response(toaster.error("Erro ao salvar - " + msg), {
        status: 203,
        headers: { "Content-Type": "text/html" }
      });
    }

    return new Response(toaster.success( "/management/product-types"), {
        status: 200,
        headers: { "Content-Type": "text/html" }
      });

  } catch (error) {
    console.error("Erro ao processar formulário:", error);
    return new Response("Erro interno do servidor", { status: 500 });
  }
}

---

<Management>

<div class="page">
  <BreadCrumbs path='management/product-types,management/product-types/add' name="Categorias, Adicionar" />

  <h1 class="text-3xl font-semibold">Categorias</h1>
  <Link url="/management/product-types" cl="btn-neutral mt-8">Voltar</Link>

  <form class="mt-8" hx-post="/management/product-types/add" hx-target="#message">
    <fieldset class="fieldset">
      <legend class="fieldset-legend">Nome</legend>
      <input type="text" class="input" name="name" placeholder="Insira o nome" />
      <p id="name-message"></p>
    </fieldset>
    <fieldset class="fieldset">
         <legend class="fieldset-legend">Url Interna</legend>
         <input type="text" class="input" name="pictureUrl" placeholder="/image1.jpg" />
         <p id="pic-message"></p>
       </fieldset>

    <button  class="btn-primary mt-8" type="submit" >Salvar</button>
  </form>

  <p id="message"></p>
</div>


</Management>
