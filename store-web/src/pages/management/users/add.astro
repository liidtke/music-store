---
import Management from '@layouts/Management.astro';
import toaster from '@utils/toaster'
import Link from "@components/Link.astro";
import BreadCrumbs from "@components/BreadCrumbs.svelte";

let data = null;

// Handler do POST no topo do arquivo .astro
if (Astro.request.method === "POST") {
  try {
    console.log('receiving post')
    const form = await Astro.request.formData();
    const name = form.get("name") as string;
    const email = form.get("email") as string;

    // Validação básica
    if (!name) {
      return toaster.inputValidation("name-message", "Nome Obrigatório")
    }

    if (!email) {
      return toaster.inputValidation("email-message", "Email Obrigatório")
    }

    let body = {name:name, email:email}

    const response = await Astro.locals.fetchWithAuth("users", {method:'POST', body:JSON.stringify(body)});
    if(response.ok){
      data = await response.json();
      // console.log(data)
    }
    else{
      let msg = await response.text()
      return new Response(toaster.error("Erro ao salvar - " + msg), {
        status: 203,
        headers: { "Content-Type": "text/html" }
      });
    }

    return new Response(toaster.success( "/management/users"), {
        status: 200,
        headers: { "Content-Type": "text/html" }
      });

  } catch (error) {
    console.error("Erro ao processar formulário:", error);
    return new Response("Erro interno do servidor", { status: 500 });
  }
}

---

<Management>

<div class="page">
  <BreadCrumbs path='users,users/add' name="Usuários, Adicionar" />

  <h1 class="text-3xl font-semibold">Usuários</h1>
  <Link url="/management/users" cl="btn-neutral mt-8">Voltar</Link>

  <form class="mt-8" hx-post="/management/users/add" hx-target="#message">
    <fieldset class="fieldset">
      <legend class="fieldset-legend">Nome</legend>
      <input type="text" class="input" name="name" placeholder="Insira o nome" />
      <p id="name-message"></p>
    </fieldset>
    <fieldset class="fieldset">
      <legend class="fieldset-legend">Email</legend>
      <input type="email" class="input" name="email" placeholder="user@domain.com" />
      <p id="email-message"></p>
    </fieldset>

    <button  class="btn-primary mt-8" type="submit" >Salvar</button>
  </form>

  <p id="message"></p>
</div>


</Management>
