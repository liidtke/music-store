---
export const prerender = false;
import App from '@layouts/App.astro';
import Link from '@components/Link.astro';
import toaster from '@utils/toaster'
import BreadCrumbs from "@components/BreadCrumbs.svelte";
import * as shared from '@utils/shared';

let data = null;
let isAdmin = false;
let roles = [...shared.roles];

if (Astro.request.method === "GET") {

  const { slug } = Astro.params;
  if(slug){
    const result = await Astro.locals.fetchWithResult("users/" + slug);
    if(result.success){
      data = result.data;
      isAdmin = result.isAdmin;
    }
    else{
      return new Response("/app", {
        status: 307,
        headers: { "Content-Type": "text/html", "Location": "/app" }
      });

    }

      console.log('r0', data);
    let org = data.organizations && data.organizations.length > 0 ? data.organizations[0] : 0;
      const rolesResult = await Astro.locals.fetchWithResult(`custom-roles/?organizationId=${org}`);
      if(rolesResult.success){
        roles.splice(0,1);
      let items = rolesResult.data.map(i => {
        return {id: `CustomRole#${i.id}`, name: i.name }
      });
         roles.push(...items)
      console.log('r1', roles);
      }

  }
}

// Handler do POST no topo do arquivo .astro
if (Astro.request.method === "PUT") {
  try {
    const form = await Astro.request.formData();
    const id = form.get("id") as string;
    const name = form.get("name") as string;
    const email = form.get("email") as string;
    const subscription = form.get("subscription") as string;
    const role = form.get("role") as string;
    const isDeleted = form.get("isDeleted") as string;

    // Validação básica
    if (!name) {
      return new Response(toaster.error("Nome e email são obrigatórios"), {
        status: 203,
        headers: { "Content-Type": "text/html" }
      });
    }

    let body = {name, email, subscription, id: parseInt(id), isDeleted: isDeleted === "off", role:role}

    const response = await Astro.locals.fetchWithAuth("users/" + id, {method:'PUT', body:JSON.stringify(body)});
    if(response.ok){
      data = await response.json();
      // console.log(data)
    }
    else{
      let msg = await response.text()
      return new Response(toaster.error("Erro ao salvar - " + msg), {
        status: 203,
        headers: { "Content-Type": "text/html" }
      });
    }

    return new Response(toaster.success( "/app/users"), {
        status: 200,
        headers: { "Content-Type": "text/html" }
      });

  } catch (error) {
    console.error("Erro ao processar formulário:", error);
    return new Response("Erro interno do servidor", { status: 500 });
  }
}

---

<App>

<div class="page">
  <BreadCrumbs path=`users,users/${data.id}` name="Usuários, Editar" />

	<h1 class="text-3xl font-semibold">Editar Usuário</h1>

    <Link url="/app/users" cl="btn-neutral mt-8">Voltar</Link>
    <form class="mt-8" hx-put={"/app/users/" + data.id} hx-target="#message">

    { () => {if (data) return (

      <fieldset class="fieldset">
        <legend class="fieldset-legend">Nome</legend>
        <input value={data.name} type="text" class="input" name="name" placeholder="Insira o nome" />
      </fieldset>
      <fieldset class="fieldset">
        <legend class="fieldset-legend">Email</legend>
        <input value={data.email} type="email" class="input" name="email" placeholder="user@domain.com" readonly />
      </fieldset>


        <input value={data.id} type="hidden" class="input" name="id" />


      <fieldset class="fieldset">
        <legend class="fieldset-legend">Perfil</legend>
        <select class="select" name="role" id="role-select">
          {
            roles.map((i) => (
            <option value={i.id} selected={data.customRole ? i.id === `${data.role}#${data.customRole.id}` : i.id === data.role } disabled={i.id == 'Anon'} >{i.name}</option>
            ))
          }

        </select>

      </fieldset>


      <fieldset class="fieldset">
        <legend class="fieldset-legend">Plano</legend>
        <select class="select" name="subscription" id="" disabled={!isAdmin} >
          {
            shared.subscriptions.map((i) => (
            <option value={i.id} selected={i.id === data.subscription}
          >{i.name}</option>
            ))
          }

        </select>

      </fieldset>


      <fieldset class="fieldset">
        <legend class="fieldset-legend">Usuário Ativo</legend>
        <input type="checkbox"  class="checkbox" checked={!data.isDeleted} name="isDeleted" />
      </fieldset>

    )}


    }
    <button  class=" btn btn-primary mt-0" type="submit" >Salvar</button>
    </form>

  <p id="message"></p>


    { () => {
    if (isAdmin) return (
    <div class="mt-8" hx-get={"timed/?userId=" + data.id} hx-trigger="load"></div>
    )
    }
    }
	</div>

</App>
