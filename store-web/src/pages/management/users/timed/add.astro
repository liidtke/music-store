---
export const partial = true;
import toaster from '@utils/toaster'
import Modal from '@components/Modal.astro';
import * as shared from '@utils/shared';
let userId = Astro.url.searchParams.get('userId');

if (Astro.request.method === "POST") {
  try {
    const form = await Astro.request.formData();
    const number = form.get("number") as string;
    const userId = form.get("userId") as string;
    const subscription = form.get("subscription") as string;
    const startDate = form.get("startDate") as string;
    const endDate = form.get("endDate") as string;

    // Validação básica
    if (subscription === null || subscription === "Free") {
    return new Response(toaster.alert("Selecione um plano"), {
        status: 203,
        headers: { "Content-Type": "text/html" }
      });
    }
    if (!startDate) {
    return new Response(`
        <input id="startDate" hx-swap-oob="true"  type="date" class="input input-error w-full" name="startDate" />
    `, {
        status: 203,
        headers: { "Content-Type": "text/html" }
      });
    }

    if (!endDate) {
    return new Response(`
        <input id="endDate" hx-swap-oob="true"  type="date" class="input input-error w-full" name="endDate" />
    `, {
        status: 203,
        headers: { "Content-Type": "text/html" }
      });
    }

    let body = {
      startDate: new Date(startDate).toISOString(),
      endDate: new Date(endDate).toISOString(),
      number: number,
      userId:parseInt(userId),
      subscription:subscription,
      organizationId:0}

    const response = await Astro.locals.fetchWithResult("users/timed-subscriptions", {method:'POST', body:JSON.stringify(body)});
    if(!response.success){
      let msg = await response.message;
      return new Response(toaster.alert("Erro ao salvar - " + msg), {
        status: 203,
        headers: { "Content-Type": "text/html" }
      });
    }

    return new Response(toaster.success(`/app/users/${userId}`), {
        status: 200,
        headers: { "Content-Type": "text/html" }
      });

  } catch (error) {
      return new Response(toaster.alert("Erro ao salvar - " + error), {
        status: 200,
        headers: { "Content-Type": "text/html" }
      });
  }
}

---

<Modal title="Adicionar Assinatura" form="f1">
    <h3 class="text-lg font-bold">Adicionar Assinatura</h3>

    <form id="f1" class="mt-4" hx-post="/app/users/timed/add" hx-target="#f_message" >

    <fieldset class="fieldset">
        <legend class="fieldset-legend">Plano</legend>
        <select class="select" name="subscription" id="" >
          {
            shared.subscriptions.map((i) => (
            <option value={i.id}
          >{i.name}</option>
            ))
          }

        </select>
      </fieldset>

      <fieldset class="fieldset">
        <legend class="fieldset-legend">Data Início</legend>
        <input id="startDate" type="date" class="input w-full" name="startDate" />
      </fieldset>

      <fieldset class="fieldset">
        <legend class="fieldset-legend">Data Fim</legend>
        <input id="endDate" type="date" class="input w-full" name="endDate" />
      </fieldset>

      <fieldset class="fieldset w-full">
        <legend class="fieldset-legend w-full">Número</legend>
        <input id="number" type="text" class="input w-full " name="number" placeholder="Número da Transação" />
      </fieldset>

      <input type="hidden" name="userId" value={userId}>

      </form>
</Modal>
  <div id="f_message"></div>
