---
export const prerender = false;

import Link from '@components/Link.astro'
import App from '@layouts/App.astro';
import * as shared from '@utils/shared';

let data = [];

let add = "";
let search = Astro.url.searchParams.get('search');
let userId = Astro.url.searchParams.get('userId');
let p = new URLSearchParams({search:search, userId:parseInt(userId)});
add = p.toString();
console.log('url', add);
const response = await Astro.locals.fetchWithResult("users/timed-subscriptions/?" + add);
if(response.success){
  data = response.data;
}
---

<div class="divider"></div>
    <h1 class="text-xl font-semibold">Assinaturas</h1>

    <div class="mt-8 grid grid-cols-1 gap-2 md:grid-cols-2">
      <div>
    <button hx-get=`/app/users/timed/add?userId=${userId}` hx-target="#add-section" class="btn btn-secondary">Adicionar Assinatura</button>

      <div id="add-section"></div>
      </div>

        <div class="flex justify-end">
    </div>
      </div>

        <table id="tb" class="mt-4 table">
            <!-- head -->
            <thead>
              <tr class="tr">
                <th class="th">Plano</th>
                    <th class="th">Número</th>
                    <th class="th">Início</th>
                    <th class="th">Fim</th>
                    <th class="th">Cancelada</th>
                    <th class="th">Encerrada</th>
                    <th class="th"></th>
                </tr>
            </thead>
            <tbody>
        {() => {if (data.length == 0) return (
                     <tr class="tr text-center">
                      	<td class="td" colspan="8">Sem itens para exibir</td>
                     </tr>
        )}}
    {
      data.map((u) => (
                    <tr class="tr">
                      <td class="td">
        {shared.trSubscription(u.subscription)}</td>
                        <td class="td">{u.number || '-'}</td>
                        <td class="td">{new Date(u.startDate).toLocaleDateString('pt-BR')}</td>
                        <td class="td">{new Date(u.endDate).toLocaleDateString('pt-BR')}</td>
                        <td class="td">
              {u.isCanceled ? <span class="badge badge-error">Sim</span> : <span class="badge badge-success">Não</span>}
            </td>
            <td class="td">
              {u.hasEnded ? <span class="badge badge-warning">Sim</span> : <span class="badge badge-success">Não</span>}
            </td>
                        <td>

        <button class="table-action" hx-get=`/app/users/timed/${u.id}` hx-target="#add-section">Editar</button>
          </td>
                    </tr>
        ))

        }

            </tbody>
        </table>
