---
export const partial = true;
const organizationId = Astro.url.searchParams.get("url") || "";

const result = await Astro.locals.fetchWithResult(`custom-roles/?organizationId=${organizationId}`);
const data = result.data ?? [];

---

<select class="select outline-none" name="customRoleId" id="custom-role-select" >
  <option disabled selected value="">Selecione uma Perfil</option>
  {data.map(cr => (
    <option value={cr.id}>{cr.name}</option>
  ))}
</select>

