---
export const prerender = false;
import toaster from '@utils/toaster'
import Link from '@components/Link.astro';
import SearchInput from '@components/SearchInput.astro'
import BreadCrumbs from "@components/BreadCrumbs.svelte";
import Management from '@layouts/Management.astro';

const formatter = new Intl.NumberFormat("pt-BR", {
  minimumFractionDigits: 2,
  maximumFractionDigits: 2,
});

let data = [];

let add = "";
let search = Astro.url.searchParams.get('search');
console.log('search is ', search)
if(search){
  let p = new URLSearchParams({search:search});
  add = p.toString();
}
 const response = await Astro.locals.fetchWithResult("products?" + add);
if(response.success){
  data = response.data;
}

---
<Management>

<div class="page">
  <BreadCrumbs path="management/products" name="Produtos" />

	<h1 class="text-3xl font-semibold">Produtos</h1>

	<div class="mt-8 grid grid-cols-1 gap-2 md:grid-cols-2">
      <div>
        <Link url="/management/products/add" cl="btn-primary">
        Adicionar Produto
        </Link>
      </div>

      <SearchInput
           get="/management/products"
           trigger="keyup changed delay:500ms queue:last"
           target="#tb"
           select="#tb"
           swap="outerHTML"
           push="true"
           name="search"
           placeholder="Buscar"
           />
      </div>

		<table id="tb" class="mt-8 table">
			<!-- head -->
			<thead>
				<tr>
					<th class="th">Nome</th>
					<th class="th">Profissional</th>
					<th class="th">Tipo</th>
					<th class="th">Valor</th>
					<th class="th">Status</th>
					<th></th>
				</tr>
			</thead>
			<tbody>
        {
() => {if (data.length == 0) return (
					 <tr class="tr text-center">
					 	<td class="td" colspan="7">Sem itens para exibir</td>
					 </tr>
        )}
        }
    {
      data.map((u) => (
					<tr class="tr">
						<td class="td">{u.name}</td>
						<td class="td">{u.professionalName}</td>
						<td class="td">{u.productType.name}</td>
						<td class="td">{formatter.format(u.unitPrice)}</td>
						<td class="td">{u.isActive ? 'Ativo': 'Inativo' }</td>
          <td class="td">
          <Link url=`/management/products/${u.id}` cl="table-action">Editar</Link>
          </td>

					</tr>
        )

        )}

			</tbody>
		</table>

    </div>



</Management>
