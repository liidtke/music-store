---
import Management from '@layouts/Management.astro';
import toaster from '@utils/toaster'
import Link from "@components/Link.astro";
import BreadCrumbs from "@components/BreadCrumbs.svelte";
import CurrencyInput from '@components/CurrencyInput.astro';
import NumberInput from '@components/NumberInput.astro';

let data = [];

if (Astro.request.method === "GET") {
  const { slug } = Astro.params;
  if(slug){
    const result = await Astro.locals.fetchWithResult("products/" + slug);
    console.log(result)
    if(result.success){
      data = result.data;
    }
    else{
      return new Response("/management/products", {
        status: 307,
        headers: { "Content-Type": "text/html", "Location": "/management" }
      });

    }


  }
}

// Handler do POST no topo do arquivo .astro
if (Astro.request.method === "PUT") {
  try {
    const form = await Astro.request.formData();
    const id = form.get("id") as string;
    const name = form.get("name") as string;
    const description = form.get("description") as string;
    const professionalId = form.get("professionalId") as string;
    const productTypeId = form.get("productTypeId") as string;
    let unitPrice = form.get("unitPrice") as string;
    let oldUnitPrice = form.get("oldUnitPrice") as string;
    const effort = form.get("effort") as string;
    const minDeadLine = form.get("minDeadLine") as string;
    const isActive = form.get("isActive") as string;
    const imageUrl = form.get("imageUrl") as string;

    if (unitPrice) {
      unitPrice = unitPrice.replace(",", ".");
    }

    if (oldUnitPrice) {
      oldUnitPrice = oldUnitPrice.replace(",", ".");
    }

    // Validação básica
    if (!name) {
      return toaster.inputValidation("name-msg", "Nome Obrigatório")
    }

    if (!professionalId) {
      return toaster.inputValidation("professional-msg", "Profissional Obrigatório")
    }

    if (!minDeadLine) {
       return toaster.inputValidation("minDeadLine-msg", "Prazo Obrigatório")
     }

    let body =
      {
        id,
        name,
        isActive:true,
        professionalId,
        productTypeId,
        unitPrice: parseFloat(unitPrice) ??0,
        oldUnitPrice: parseFloat(oldUnitPrice)??0,
        effort: parseInt(effort)??0,
        minDeadLine: parseInt(minDeadLine)??0,
        imageUrl,
        description
      }

    const response = await Astro.locals.fetchWithResult("products/" + body.id, {method:'PUT', body:JSON.stringify(body)});
    if(response.success){
      data = response.data
    }
    else{
      let msg = await response.message;
      return new Response(toaster.error("Erro ao salvar - " + msg), {
        status: 203,
        headers: { "Content-Type": "text/html" }
      });
    }

    return new Response(toaster.success( "/management/products"), {
        status: 200,
        headers: { "Content-Type": "text/html" }
      });

  } catch (error) {
    console.error("Erro ao processar formulário:", error);
    return new Response("Erro interno do servidor", { status: 500 });
  }
}

---

<Management>

<div class="page">
  <BreadCrumbs path='management/products,management/products/add' name="Produtos, Editar" />

  <h1 class="text-3xl font-semibold">Produtos</h1>
  <Link url="/management/products" cl="btn-neutral mt-8">Voltar</Link>
  <button  class="btn-primary mt-8" type="submit" form="f1" >Salvar</button>

  <form id="f1" class="mt-8" hx-put={"/management/products/"+data.id} hx-target="#message" hx-disinherit="*" >
    <fieldset class="fieldset">
      <legend class="fieldset-legend">Nome</legend>
      <input type="text" class="input" name="name" placeholder="Insira o nome" value={data.name} />
      <p id="name-msg"></p>
    </fieldset>

    <input type="hidden" name="id" value={data.id} >

    <div hx-get={"/partials/product-type-select/?selected="+ data.productType.id } hx-trigger="load">
      <fieldset class="fieldset">
           <legend class="fieldset-legend">Categoria</legend>
           <input type="text" class="input" />
         </fieldset>
    </div>

    <div hx-get={"/partials/professional-select?selected="+ data.professionalId } hx-trigger="load">
      <fieldset class="fieldset">
           <legend class="fieldset-legend">Profissional</legend>
           <input type="text" class="input" />
         </fieldset>
    </div>

    <fieldset class="fieldset">
      <legend class="fieldset-legend">Descrição</legend>
      <input type="text" class="input" name="description" value={data.description} />
      <p id="description-msg"></p>
    </fieldset>


    <fieldset class="fieldset">
         <legend class="fieldset-legend">Url Imagem</legend>
         <input type="text" class="input" name="imageUrl" value={data.imageUrl} />
         <p id="image-msg"></p>
       </fieldset>

    <fieldset class="fieldset">
      <legend class="fieldset-legend">Valor</legend>
      <CurrencyInput name="unitPrice" value={data.unitPrice} ></CurrencyInput>
      <p id="unitPrice-msg"></p>
    </fieldset>

    <fieldset class="fieldset">
      <legend class="fieldset-legend">Valor Anterior</legend>
      <CurrencyInput name="oldUnitPrice" value={data.oldUnitPrice}></CurrencyInput>
      <p id="oldUnitPrice-msg"></p>
    </fieldset>

    <fieldset class="fieldset">
      <legend class="fieldset-legend">Esforço (1-10)</legend>
      <NumberInput name="effort" value={data.effort} />
      <p id="effort-msg"></p>
    </fieldset>

    <fieldset class="fieldset">
      <legend class="fieldset-legend">Prazo Mínimo (dias)</legend>
      <NumberInput name="minDeadLine" value={data.minDeadLine} />
      <p id="minDeadLine-msg"></p>
    </fieldset>

  </form>

  <p id="message"></p>

  <div class="border-b"></div>
  <div class="mt-8" hx-get={"samples?productId=" + data.id} hx-swap="innerHTML" hx-trigger="load delay:1s" >

  </div>

</div>


</Management>
