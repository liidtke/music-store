---
export const prerender = false;
import toaster from '@utils/toaster'
import Link from '@components/Link.astro';
import SearchInput from '@components/SearchInput.astro'
import BreadCrumbs from "@components/BreadCrumbs.svelte";
import Management from '@layouts/Management.astro';

let data = [];

let productId = Astro.url.searchParams.get('productId');

let p = new URLSearchParams({productId});
let add = p.toString();

const response = await Astro.locals.fetchWithResult("samples?" + add);

if(response.success){
  data = response.data;
}
console.log(data)

---

<h1 class="text-2xl font-semibold">Samples</h1>

<div class="mt-8 grid grid-cols-1 gap-2 md:grid-cols-2">
  <div>
    <button class="btn-secondary" hx-get={"sample-add?productId=" + productId} hx-target="#mw">
      Adicionar Sample
    </button>
    <div id="mw"></div>
  </div>

</div>

<table id="tb" class="mt-8 table">
  <!-- head -->
  <thead>
    <tr>
      <th class="th">Tipo</th>
      <th class="th">Descrição</th>
      <th></th>
    </tr>
  </thead>
  <tbody>
    {
    () => {if (data.length == 0) return (
    <tr class="tr text-center">
      <td class="td" colspan="7">Sem itens para exibir</td>
    </tr>
    )}
    }
    {
    data.map((u) => (
    <tr class="tr">
      <td class="td">{u.sampleType}</td>
      <td class="td">{u.description}</td>
      <td class="td">
        <!-- <Link url=`/management/products/${u.id}` cl="table-action">Editar</Link> -->
      </td>

    </tr>
    )

    )}

  </tbody>
</table>
