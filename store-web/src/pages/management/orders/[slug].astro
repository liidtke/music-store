---
import Management from '@layouts/Management.astro';
import toaster from '@utils/toaster'
import Link from "@components/Link.astro";
import BreadCrumbs from "@components/BreadCrumbs.svelte";
import CurrencyInput from '@components/CurrencyInput.astro';
import NumberInput from '@components/NumberInput.astro';
import dateConverter from '@utils/date-converter'

let data = [];
let id = "";

if (Astro.request.method === "GET") {
  const { slug } = Astro.params;
  id = slug;
  if(slug){
    const result = await Astro.locals.fetchWithResult("orders/" + slug);
    console.log(result)
    if(result.success){
      data = result.data;
    }
    else{
      return new Response("/management/orders", {
        status: 307,
        headers: { "Content-Type": "text/html", "Location": "/management" }
      });
    }
  }
}

if (Astro.request.method === "PUT") {
  try {
    const form = await Astro.request.formData();
    const id = form.get("id") as string;
    const status = form.get("status") as string;
    const paymentStatus = form.get("paymentStatus") as string;
    const deliveryDate = form.get("deliveryDate") as string;

    if (!id) {
      return new Response(toaster.error("Id não informado"), {
        status: 203,
        headers: { "Content-Type": "text/html" }
      });
    }

    let body = {
      id,
      status:parseInt(status),
      paymentStatus: parseInt(paymentStatus),
      deliveryDate: dateConverter.parse(deliveryDate)
    }
    console.log(body);

    const response = await Astro.locals.fetchWithResult("orders/" + id, {method:'PUT', body:JSON.stringify(body)});

    if(!response.success){
      let msg = await response.message;
      return new Response(toaster.error("Erro ao salvar - " + msg), {
        status: 203,
        headers: { "Content-Type": "text/html" }
      });
    }

    return new Response(toaster.success( "/management/orders"), {
      status: 200,
      headers: { "Content-Type": "text/html" }
    });

  } catch (error) {
    console.error("Erro ao processar formulário:", error);
    return new Response("Erro interno do servidor", { status: 500 });
  }
}


function orderStatusToString(status) {
  const statusMap = {
    1: "Criado",
    2: "Confirmado",
    3: "Em Andamento",
    4: "Completo",
    5: "Cancelado"
  };

  return statusMap[status] || "Unknown";
}


function paymentStatusStatusToString(status) {
  const statusMap = {
    1: "Pendente",
    2: "Pago",
    3: "Estornado"
  };

  return statusMap[status] || "Unknown";
}

function paymentMethodToString(status) {
  const statusMap = {
    0: "Manual",
    1: "Pagamento Direto",
    2: "Pix",
    3: "Dinheiro"
  };

  return statusMap[status] || status;
}

const formatter = new Intl.NumberFormat("pt-BR", {
  minimumFractionDigits: 2,
  maximumFractionDigits: 2,
});

export const paymentStatuses = [
  {id:1, name: "Pendente"},
  {id:2, name: "Pago"},
  {id:3, name: "Estornado"},
];

export const orderStatuses = [
  {id:1, name: "Criado"},
  {id:2, name: "Confirmado"},
  {id:3, name: "Em Andamento"},
  {id:4, name: "Completo"},
  {id:5, name: "Cancelado"},
];

---

<Management>

  <div class="page">
    <BreadCrumbs path='management/orders,management/orders' name="Pedidos, Editar" />

    <h1 class="text-3xl font-semibold">Detalhes do Pedido</h1>
    <Link url="/management/products" cl="btn-neutral mt-8">Voltar</Link>
    <button  class="btn-primary mt-8" type="submit" form="edit-order" >Salvar</button>

    <div class="mt-8 grid grid-cols-2 grid-gap-2">
      <form hx-put='' id="edit-order" hx-target="#message"  >

      <div class=" space-y-4 rounded-lg border border-gray-300 p-6">
        <!-- <h2 class="text-2xl font-semibold mb-4">Pedido</h2> -->
        <input type="hidden" name="id" value={id}>

        <div>
          <label class="text-sm text-gray-900 font-semibold" for="">Valor</label>
          <p class="text-">{formatter.format(data.value)}</p>
        </div>
        <div>
          <label class="text-sm text-gray-900 font-semibold" for="">Data</label>
          <p class="text-">{dateConverter.toString(data.occurred, 'L LT')}</p>
        </div>



        <div>
          <label class="text-sm text-gray-900 font-semibold" for="">Forma de Pagamento</label>
          <p class="text-">{paymentMethodToString(data.paymentMethod)}</p>
        </div>

        <div>
          <label class="text-sm text-gray-900 font-semibold" for="">Status</label>

          <select class="select" name="status" id="status-select">
            {
            orderStatuses.map((i) => (
            <option value={i.id} selected={orderStatuses[data.status].id == i.id } >{i.name}</option>
            ))
            }
          </select>

          <!-- <p class="text-">{orderStatusToString(data.status)}</p> -->
        </div>


        <div>
          <label class="text-sm text-gray-900 font-semibold" for="">Status de Pagamento</label>

          <select class="select" name="paymentStatus" id="paymentstatus-select">
            {
            paymentStatuses.map((i) => (
            <option value={i.id} selected={paymentStatuses[data.status].id == i.id } >{i.name}</option>
            ))
            }
          </select>

          <!-- <p class="text-">{paymentStatusStatusToString(data.paymentStatus)}</p> -->
        </div>


        <div>
          <label class="text-sm text-gray-900 font-semibold" for="">Data Prevista Entrega</label>
          <fieldset>
            <input type="text" class="input" name="deliveryDate" value={dateConverter.toString(data.deliveryDate)}>
          </fieldset>
          <!-- <p class="text-">{dateConverter.toString(data.deliveryDate)}</p> -->
        </div>



      </div>

      </form>



      <div class=" space-y-4 rounded-lg border border-gray-300 bg-gray-100 p-6">
        <h2 class="text-2xl font-semibold mb-4">Cliente</h2>

        <div>
          <label class="text-sm text-gray-900 font-semibold" for="">Nome</label>
          <p class="text-">{data.customer.name}</p>
        </div>

        <div>
          <label class="text-sm text-gray-900 font-semibold" for="">Email</label>
          <p class="text-">{data.customer.email}</p>
        </div>

        <div>
          <label class="text-sm text-gray-900 font-semibold" for="">Telefone</label>
          <p class="text-">{data.customer.phone}</p>
        </div>

        <div>
          <label class="text-sm text-gray-900 font-semibold" for="">Documento</label>
          <p class="text-">{data.customer.document}</p>
        </div>

        <div>
          <label class="text-sm text-gray-900 font-semibold" for="">Mensagem</label>
          <p class="text-">{data.message ?? '-'}</p>
        </div>

      </div>




    </div>


    <h1 class="text-2xl font-semibold mt-8">Itens do Pedido</h1>

    <table id="tb" class="mt-8 table">
      <thead>
        <tr>
          <th class="th">Produto</th>
          <th class="th">Quantidade</th>
          <th class="th">Valor Unitário</th>
          <th class="th">Profissional</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        {data.items.map((item) => (

        <tr class="tr">
          <td class="td"> {item.product.name} </td>
          <td class="td"> {item.quantity} </td>
          <td class="td"> {formatter.format(item.product.unitPrice)} </td>
          <td class="td"> {item.product.professionalName} </td>

          <!-- <td class="td"> -->
          <!-- <Link url=`/management/orders/${o.id}` cl="table-action">Detalhes</Link> -->
          <!-- </td> -->

        </tr>

        )
        )}
      </tbody>
    </table>


    <div id="message"></div>
    <form action="" class="f1"></form>

    <p id="message"></p>
    <div id="image-modal"></div>

    <div class="border-b"></div>

  </div>

  </div>


</Management>
