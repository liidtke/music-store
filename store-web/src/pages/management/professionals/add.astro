---
import Management from '@layouts/Management.astro';
import toaster from '@utils/toaster'
import Link from "@components/Link.astro";
import BreadCrumbs from "@components/BreadCrumbs.svelte";
import QuillEditor from "@components/QuillEditor.svelte";

let data = null;

// Handler do POST no topo do arquivo .astro
if (Astro.request.method === "POST") {
  try {
    console.log('receiving post')
    const form = await Astro.request.formData();
    const userId = form.get("userId") as string;
    const name = form.get("name") as string;
    const document = form.get("document") as string;
    const bulkDiscount = form.get("bulkDiscount") as string;
    const isActive = form.get("isActive") as string;
    const pixKey = form.get("pixKey") as string;
    const isManager = form.get("isManager") as string;
    const pictureUrl = form.get("pictureUrl") as string;
    const profile = form.get("profile") as string;
    const title = form.get("title") as string;

    // Validação básica
    if (!name) {
      return toaster.inputValidation("name-message", "Nome Obrigatório")
    }

    if (!profile) {
      return toaster.inputValidation("profile-message", "Perfil Obrigatório")
    }

    if (!document) {
       return toaster.inputValidation("document-message", "Documento Obrigatório")
     }

    let body = {name, id:userId, title:title, document, bulkDiscount : parseInt(bulkDiscount), isActive: isActive == "on", pixKey, isManager: isManager == "on", pictureUrl, profile}

    const response = await Astro.locals.fetchWithResult("professionals", {method:'POST', body:JSON.stringify(body)});
    if(response.success){
      data = response.data;
    }
    else{
      let msg = await response.message;
      return new Response(toaster.error("Erro ao salvar - " + msg), {
        status: 203,
        headers: { "Content-Type": "text/html" }
      });
    }

    return new Response(toaster.success( "/management/professionals"), {
        status: 200,
        headers: { "Content-Type": "text/html" }
      });

  } catch (error) {
    console.error("Erro ao processar formulário:", error);
    return new Response("Erro interno do servidor", { status: 500 });
  }
}

---

<Management>

<div class="page">
  <BreadCrumbs path='management/professionals,management/professionals/add' name="Profissionais, Adicionar" />

  <h1 class="text-3xl font-semibold">Profissionais</h1>
  <Link url="/management/professionals" cl="btn-neutral mt-8">Voltar</Link>
  <button  class="btn-primary mt-8" type="submit" form="create" >Salvar</button>

  <form id="create" class="mt-8 grid grid-cols-1 gap-x-4 md:grid-cols-2 " hx-post="/management/professionals/add" hx-target="#message" hx-disinherit="*" >

    <div hx-get="/partials/user-select" hx-trigger="load" ></div>

    <fieldset class="fieldset">
      <legend class="fieldset-legend">Nome</legend>
      <input type="text" class="input" name="name" placeholder="Insira o nome" />
      <p id="name-message"></p>
    </fieldset>

    <fieldset class="fieldset">
         <legend class="fieldset-legend">Título</legend>
         <input type="text" class="input" name="title" placeholder="ex: Produtor Musical" />
         <p id="name-message"></p>
       </fieldset>

    <fieldset class="fieldset">
      <legend class="fieldset-legend">Documento</legend>
      <input type="text" class="input" name="document" placeholder="" />
      <p id="document-message"></p>
    </fieldset>

    <fieldset class="fieldset">
      <legend class="fieldset-legend">Chave Pix</legend>
      <input type="text" class="input" name="pixKey" placeholder="" />
      <p id="pix-message"></p>
    </fieldset>

    <fieldset class="fieldset">
      <legend class="fieldset-legend">Url Imagem</legend>
      <input type="text" class="input" name="pictureUrl" placeholder="" />
      <p id="pic-message"></p>
    </fieldset>

    <fieldset class="fieldset">
      <legend class="fieldset-legend">Desconto (no combo)</legend>
      <input type="text" class="input" name="bulkDiscount" placeholder="" value="0" />
      <p id="discount-message"></p>
    </fieldset>

    <fieldset class="fieldset">
         <legend class="fieldset-legend">Gerenciador</legend>
         <input type="checkbox" class="checkbox" name="isManager" />
    </fieldset>

    <div></div>


    <div class="col-span-2">

      <h4 class="font-semibold text-lg">Perfil</h4>
      <p id="profile-message"></p>

    <QuillEditor
      client:load
      name="profile"
    />

    </div>


  </form>

  <p id="message"></p>
</div>


</Management>
