---

export const prerender = false;
import Link from '@components/Link.astro';
import * as shared from '@utils/shared';
import toaster from '@utils/toaster'
import Store from '@layouts/Store.astro';

let data = {};
let isAdmin = false;
let roles = [...shared.roles];

if (Astro.request.method === "GET") {

    const result = await Astro.locals.fetchWithResult("users/current");
    if(result.success){
      data = result.data;
      isAdmin = result.isAdmin;
    }
    else {
      return new Response("/app", {
        status: 307,
        headers: { "Content-Type": "text/html", "Location": "/app" }
      });
  }
}

---

<Store>

  <div class="max-w-screen-xl mt-4 max-lg:max-w-3xl md:min-w-180 mx-auto h-full">

  <div class="page md:p-8 h-full">
    <h1 class="text-2xl font-semibold">Meu Perfil</h1>
    <div class="border-b border-gray-300 pb-4"></div>

    <div class="grid md:grid-cols-2 mt-8 gap-x-8">


      <fieldset class="fieldset">
        <legend class="fieldset-legend">Nome</legend>
        <input value={data.name} type="text" class="input readonly" name="name" readonly />
      </fieldset>

      <fieldset class="fieldset">
        <legend class="fieldset-legend">Email</legend>
        <input value={data.email} type="text" class="input readonly" readonly />
      </fieldset>

      <fieldset class="fieldset">
        <legend class="fieldset-legend">Perfil</legend>
        <select class="select" name="role" disabled id="role-select">
          {
            roles.map((i) => (
            <option value={i.id} selected={data.role == i.id} disabled={i.id == 'Anon'} >{i.name}</option>
            ))
          }
        </select>
      </fieldset>

    </div>

      <h2 class="text-2xl font-semibold mt-8">Dados Pessoais</h2>

      <div class="grid md:grid-cols-2 mt-8 gap-x-8">
      </div>

  </div>

</Store>
