                  <p class="bg-red-100 text-[13px] font-medium text-red-600 mt-2 inline-block rounded-md py-1.5 px-3">Cancelled</p>
                </div>
                <div class="md:ml-auto">
                  <h6 class="text-sm font-medium text-slate-500">Price</h6>
                  <p class="text-sm text-slate-900 font-medium mt-2">$20.00</p>
                </div>
              </div>

              <div class="grid grid-cols-5 max-md:grid-cols-2 items-start justify-between gap-6 py-4">
                <div class="md:col-span-2 flex sm:items-center gap-4 max-sm:flex-col">
                  <div class="bg-gray-100 p-2 rounded-lg w-16 h-16 shrink-0">
                    <img src='https://readymadeui.com/images/sunscreen-img-4.webp' class="w-full h-full object-contain" />
                  </div>
                  <div>
                    <h6 class="text-[15px] font-medium text-slate-900">Sunscreen</h6>
                  </div>
                </div>
                <div>
                  <h6 class="text-sm font-medium text-slate-500">Delivery Date</h6>
                  <p class="text-sm text-slate-900 font-medium mt-2">May 10, 2025</p>
                </div>
                <div>
                  <h6 class="text-sm font-medium text-slate-500">Order Status</h6>
                  <p class="bg-green-100 text-[13px] font-medium text-green-600 mt-2 inline-block rounded-md py-1.5 px-3">Completed</p>
                </div>
                <div class="md:ml-auto">
