---
import Store from "@layouts/Store.astro"

---

<Store>

  <div class="flex flex-col items-center text-center mt-8">
      <h1 class="text-3xl md:text-4xl font-semibold mb-4 text-gray-800">Nossos Profissionais</h1>
      <p class="w-3/5 mb-8 text-gray-500 text-sm">Temos uma pequena seleção de profissionais que irá se expandir a medida que nosso produto for apreciado de forma que o futuro próximo será brevemente breve.</p>
      <div class="flex flex-wrap gap-6 items-center justify-center">

        <div hx-get="/partials/public/professionals" hx-trigger="load"></div>

      </div>
  </div>

</Store>
