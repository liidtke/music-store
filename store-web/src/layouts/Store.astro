---
import "../styles/global.css";
import '@unocss/reset/normalize.css';
import Masthead from "@components/Masthead.astro";
import Link from "@components/Link.astro";
const { content } = Astro.props;

let data = {};
let isAdmin = false;


if (Astro.request.method === "GET") {
  try{
    const hxRequest = Astro.request.headers.get('HX-Request');
    const hxTarget = Astro.request.headers.get('HX-Target');

    if(!hxTarget){
      const result = await Astro.locals.fetchWithResult("users/current");
      //todo add redirect if not admin or professional
      if (result.success) {
        data = result.data;
        isAdmin = result.isAdmin;
      } else {
        console.log('response is NOT ok', result.message)
      }
    }
  }
  catch(err){

  }
}

