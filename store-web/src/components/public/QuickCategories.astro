---
// CategoryGrid.astro
// Converted from Svelte

import images from "@utils/images"

export interface Category {
  id: number | string;
  name: string;
  description: string;
  imageUrl: string;
}

export interface Props {
  data: Category[];
}

const { data } = Astro.props;
---

<div class="mt-4">
  <h2 class="text-2xl sm:text-xl font-semibold mb-6 sm:mb-8">Categorias</h2>

  <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 sm:gap-6 gap-4">
    {data.map((item) => (
      <div
        class="cursor-pointer relative xl:max-w-3/4 "
        hx-get={`/products?product-type=${item.id}`}
        hx-target="main"
        hx-select="main"
        hx-push-url="true"
      >
        <div class="aspect-square overflow-hidden mx-auto  ">
          <img
            src={images.parse(item.imageUrl)}
            alt={item.name}
            class="h-full w-full rounded-md object-cover object-top"
          />
        </div>

        <div class="mt-4 px-2">
          <h4 class="text-slate-900 text-sm font-semibold">{item.name}</h4>
          <p class="mt-1 text-xs text-slate-600 font-medium">{item.description}</p>

          <button
            hx-get={`/products?product-type=${item.id}`}
            hx-target="main"
            hx-select="main"
            hx-push-url="true"
            class="mt-2 block text-[13px] text-blue-600 font-medium"
          >
            Detalhes →
          </button>
        </div>
      </div>
    ))}
  </div>
</div>
