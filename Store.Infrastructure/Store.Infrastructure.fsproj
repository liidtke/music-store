<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
    </PropertyGroup>

    <ItemGroup>
        <Compile Include="Context.fs" />
        <Compile Include="Access\Models.fs" />
        <Compile Include="Access\UserRepository.fs" />
        <Compile Include="Access\UserVerificationRepository.fs" />
        <Compile Include="Store\Models.fs" />
        <Compile Include="Store\ProductTypeRepository.fs" />
        <Compile Include="Store\ProfessionalRepository.fs" />
        <Compile Include="Store\ProductRepository.fs" />
        <Compile Include="Store\CustomerRepository.fs" />
        <Compile Include="Store\SampleRepository.fs" />
        <Compile Include="Store\BasketRepository.fs" />
        <Compile Include="Store\OrderRepository.fs" />
        <Compile Include="Integrations.fs" />
        <Compile Include="MailSender.fs" />
        <Compile Include="Serializers.fs" />
        <Compile Include="PaymentProcessor.fs" />
        <Content Include="mongoscript" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Store.Domain\Store.Domain.fsproj" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Falco.Markup" Version="1.4.0" />
        <PackageReference Include="Flurl" Version="4.0.0" />
        <PackageReference Include="Flurl.Http" Version="4.0.2" />
        <PackageReference Include="MongoDB.Bson" Version="3.6.0" />
        <PackageReference Include="MongoDB.Driver" Version="3.6.0" />
    </ItemGroup>

</Project>
